# AXIOM backend — environment manifest.
#
# NAMES AND EXPLANATIONS ONLY. No values, no secrets. Copy to `.env` and fill in.
#
# Every variable the application code reads is listed. Verified by AST scan of
# every os.environ / os.getenv call under services/ and scripts/ —
# 59 read, 59 documented. `scripts/check-env-manifest.py` re-checks that on
# demand and fails if the two drift.
#
# WHAT THE COLUMNS MEAN
#   REQUIRED   the process will not start, or the feature is dead, without it
#   OPTIONAL   has a working default; set it to change behaviour
#   PLATFORM   set on the host (Railway), NOT read by this code — see the last
#              section, and read it before assuming the Procfile governs
#
# ⭐ THE QUIET FAILURES ARE THE DANGEROUS ONES. Missing DATABASE_URL stops the
# process, which is loud and unmissable. Missing R2_* returns 503 on upload, and
# missing RESEND_API_KEY means no invite, no verification and no password reset
# ever arrives — with nothing in the UI to say why. Those two read as product
# bugs rather than configuration, and they are the ones to set first after the
# database.


# ── DATABASE ────────────────────────────────────────────────────────────────
# REQUIRED. The only variable read without a default anywhere in the codebase
# (services/api/accounts.py, os.environ["DATABASE_URL"]). Absent -> KeyError at
# import, before the server binds a port.
# Postgres in production; SQLite works for tests (sqlite:///path.db).
DATABASE_URL=


# ── AUTH & ACCESS ───────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Signs session tokens. Defaults to the literal string
# "dev-secret-change-me", so the app BOOTS without it and every token is
# forgeable by anyone who has read this file. Loud in consequence, silent at
# startup.
AXIOM_SECRET=

# OPTIONAL. Email address granted super-admin rights on sign-up. Empty default.
SUPER_ADMIN_EMAIL=

# OPTIONAL. Bearer token for administrative endpoints. Unset -> those endpoints
# are unreachable rather than open.
AXIOM_ADMIN_TOKEN=

# OPTIONAL. Comma-separated CORS origins. Empty default.
# ⭐ Port-sensitive: the local verification harness runs on 4175 because that is
# what this list contains. On any other port every call is CORS-blocked, login
# fails silently, and the app falls back to demo mode — which reads as a product
# difference. That confusion has cost a debugging cycle before.
AXIOM_ALLOWED_ORIGINS=

# OPTIONAL. Feature gates. Empty (falsey) default; set to a truthy value to enable.
AXIOM_REQUIRE_AUTH=
AXIOM_REQUIRE_PLAN=


# ── DOCUMENT STORAGE — Cloudflare R2 ────────────────────────────────────────
# REQUIRED FOR UPLOADS. All four, or none work. Every uploaded document and
# every generated PDF/PPTX board report is stored here.
# ⭐ FAILS QUIETLY-ISH: uploads return HTTP 503 "Document storage is not
# configured on this server". The message is honest but reads as a server fault,
# not a missing account. Reports cannot be downloaded at all.
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# ── OUTBOUND MAIL — Resend ──────────────────────────────────────────────────
# REQUIRED FOR ONBOARDING. Without it: no invitation email, no address
# verification, no password reset.
# ⭐ FAILS SILENTLY — THE WORST CASE IN THIS FILE. The API returns success, the
# UI says the invite was sent, and nothing arrives. Nobody discovers it until a
# customer says they never got the email.
RESEND_API_KEY=
# OPTIONAL. From-address. Defaults to "AXIOM <no-reply@axiomdynamics.app>".
MAIL_FROM=


# ── MODEL PROVIDER — Anthropic ──────────────────────────────────────────────
# REQUIRED FOR AI FEATURES. Powers Prescience (Ask AXIOM), document
# intelligence, and assessment sentiment analysis.
# Unset -> those surfaces refuse rather than crash; the rest of the app is fine.
ANTHROPIC_API_KEY=

# OPTIONAL. Model selection. Defaults shown are what production runs.
AXIOM_AI_MODEL=                    # default claude-sonnet-4-6
AXIOM_PRESCIENCE_MODEL=            # default claude-sonnet-4-6
AXIOM_SENTIMENT_MODEL=             # default claude-haiku-4-5-20251001

# OPTIONAL. Rate and cost control. Defaults in comments.
AXIOM_AI_RATE_LIMIT=               # default 10   (requests/min)
AXIOM_PRESCIENCE_DAILY_CAP=        # default 200  (per user/day)
AXIOM_PRESCIENCE_GLOBAL_DAILY_CAP= # default 90   (whole platform/day)
AXIOM_PRESCIENCE_ANON_CAP=         # default 6    (anonymous visitor)
AXIOM_PRESCIENCE_VIEWER_DAILY_CAP= # default 6    (view-only member)
AXIOM_PRESCIENCE_HISTORY=          # default 10   (turns of context)
AXIOM_PRESCIENCE_MAX_TOKENS=       # default 1500
AXIOM_ANON_SALT=                   # default axiom-prescience (anon rate-limit hashing)

# OPTIONAL. Document-intelligence chunking and injection budgets.
AXIOM_DOC_CHUNK_CHARS=             # default 2400
AXIOM_DOC_INJECT_MAX_CHUNKS=       # default 12
AXIOM_DOC_INJECT_PER_DOC=          # default 6
AXIOM_DOC_INJECT_TOKENS=           # default 5000
AXIOM_DOC_SCANNED_MIN=             # default 20    (chars/page below this => scanned PDF)
AXIOM_DOC_SYNTH_MAX_INPUT=         # default 120000
AXIOM_DOC_SYNTH_MAX_TOKENS=        # default 4000


# ── PAYMENTS — Stripe ───────────────────────────────────────────────────────
# REQUIRED FOR BILLING ONLY. Unset -> checkout and subscription management are
# unavailable; nothing else is affected. See docs/BILLING_SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNTS_WEBHOOK_SECRET=
# OPTIONAL. Post-checkout redirects; default to axiomdynamics.app URLs.
AXIOM_BILLING_SUCCESS_URL=
AXIOM_BILLING_CANCEL_URL=


# ── OBSERVABILITY — Sentry ──────────────────────────────────────────────────
# OPTIONAL BUT STRONGLY ADVISED. Empty default; the app runs blind without it.
# ⭐ /health reports `"monitoring": true|false`, so the ONLY way to know it is
# live is to look — it was once recorded as "shipped" while inert, because the
# code was deployed and the DSN was never set. Deployed and running are
# different claims.
SENTRY_DSN=

# G3 — the external availability probe's target (scripts/probe-availability.py).
# Optional: the script defaults to the production /health URL. Set it to point a
# probe at a different environment. ⭐ The probe runs on GitHub Actions, OUTSIDE
# Railway — a monitor inside the thing it monitors dies with it.
AXIOM_HEALTH_URL=

# OPTIONAL. Tags Sentry events and is echoed by /health, so a demo error is
# never mistaken for a production one. Default "production".
AXIOM_ENV=


# ── APPLICATION URLS & CONTENT ──────────────────────────────────────────────
APP_URL=                           # default https://axiomdynamics.app
BACKEND_URL=                       # default the Railway production URL
APP_STORE_URL=                     # default {APP_URL}/mobile
PLAY_STORE_URL=                    # default {APP_URL}/mobile
AXIOM_INTRO_VIDEO_URL=             # unset -> the intro video panel is hidden


# ── BACKGROUND WORK & SEEDING ───────────────────────────────────────────────
# OPTIONAL. Empty (falsey) default; set truthy to enable the nightly job.
AXIOM_DECISION_NIGHTLY=
AXIOM_SENTINEL_NIGHTLY=

# OPTIONAL. Default "true". Seeds the Meridian showcase company at boot.
# Covers the company, its datasets, its documents, its valuation runs AND — since
# gap 3 closed — the full assessment surface: 6 cycles, 14,430 responses, the 13
# L1 weights, and a CEI of 6.3716 matching production exactly.
# ⭐ The 30-row demo roster is the one part that does NOT appear on first boot.
# AssessmentInvite.invited_by is NOT NULL and a fresh database has no users, so
# the seed declines to invent an inviter; the roster fills itself on the first
# boot after anyone signs up. See docs/reports/2026-07-30-gap3-closed-and-coupling-survey.md.
AXIOM_SEED_SHOWCASE=


# ── SET BY THE PLATFORM ─────────────────────────────────────────────────────
# Injected by Railway. Do not set locally.
# Echoed by /health as `release` and tagged on every Sentry event, so a crawl
# and an error can be tied to one build. Absent -> /health reports release:null
# and the release gate in scripts/ refuses to run rather than passing blind.
RAILWAY_GIT_COMMIT_SHA=


# ── PLATFORM-ONLY: NOT READ BY THIS CODE. READ THIS SECTION. ────────────────
#
# ⭐⭐ FORWARDED_ALLOW_IPS
#
# Set as a Railway environment variable, NOT in this file and NOT in the
# Procfile. Uvicorn reads it directly.
#
# THE PROCFILE DOES NOT GOVERN THIS. Railway ignores the Procfile and runs its
# own start command, so the `--forwarded-allow-ips="*"` flag written there has
# no effect — the platform variable is what is actually in force. A rebuilder
# reading the Procfile would conclude the problem is handled. It is not; it is
# handled somewhere the repository cannot see.
#
# Without it, uvicorn refuses to trust X-Forwarded-For from Railway's proxy,
# every client appears to originate from the proxy, and rate limiting and audit
# attribution are wrong for every request.
#
# On a NEW deployment target this must be set again, by hand, on the host.


# ── DEVELOPER SCRIPTS ONLY ──────────────────────────────────────────────────
# Read by scripts/, never by the application. Not needed to run AXIOM.
#   OPERATOR_TOKEN                      operator auth token for the crawler
#   MEMBER_TOKEN                        member auth token for the crawler
#   AXIOM_EXPECT_RELEASE                pin the release gate to a commit
#   BACKEND_HOST                        crawler target host
#   APP_URL                             crawler target frontend
#   SETTLE_MS                           crawler per-page settle time
#   OPERATOR_RECYCLE_EVERY              browser recycling in operator mode
#   AXIOM_FRONTEND                      path to the optimization-anchor checkout
#   AXIOM_FRONTEND_OPTIONAL             let cross-repo gates skip when it is absent
#   DS_CACHE                            dataset cache file for sweeps
#   MODEL_COLUMN_BASE                   git ref for the model-column check
#   AXIOM_APP_BASE                      frontend host the prospect-route guard
#                                       fetches. Defaults to the live app: a
#                                       prospect-facing 404 is only observable
#                                       where a prospect would meet it.
#   AXIOM_DEMO_BASE                     host the comparison-matrix guard opens the
#                                       demo deep links against. Defaults to the
#                                       live demo: the linked surfaces are a
#                                       PRODUCTION artefact and only production can
#                                       answer whether they carry data. Override
#                                       only to point the guard at a staging host.
#   DATABASE_PUBLIC_URL                 externally-reachable Postgres URL, supplied
#                                       by `railway run --service Postgres`. Read by
#                                       measurement lanes and check-db-client.py.
#
# ⭐ DATABASE ACCESS FOR MEASUREMENT LANES — the invocation matters.
#   railway run --service Postgres python3 scripts/<lane>.py
# WITHOUT `--service Postgres` you get the APP service's environment, where
# DATABASE_URL points at `postgres.railway.internal` — reachable only from inside
# Railway, so a local lane fails with a DNS error that looks like a network
# problem rather than a wrong invocation. The Postgres service supplies
# DATABASE_PUBLIC_URL, which is the one a local lane can reach.
#
# Run `python3 scripts/check-db-client.py --connect --queries 60` under that same
# invocation before any measurement lane. psycopg has failed to import mid-lane
# twice, and a lane that starts on a broken client reports "undecidable" when the
# truth is "instrument down".

# ── §7s.1 B1 — pack notification (the CEO's "ready to review and release") ──
# Whether the nightly sweep should notify CEOs about packs that were published
# BEFORE the notification was wired. ⭐ DEFAULT OFF, AND DELIBERATELY SO: twenty
# packs exist in production with no CEO told, and whether they should now receive
# a burst of notifications for months already past is a USER RULING. Sending it
# is irreversible. Set to 1 only once that is ruled.
AXIOM_NOTIFY_RETROSPECTIVE=
# The pack ids that predate the wiring, comma-separated. Lets production name its
# own twenty without a code change, and lets a test exercise the gate without one.
AXIOM_PRE_WIRING_PACK_IDS=
